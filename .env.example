# ============================================================
# Variabili d'ambiente del backend Gasparella
# NON mettere questi valori nel repo GitHub.
# Vanno inseriti nel pannello Netlify: Site settings > Environment variables
# ============================================================

# --- Supabase (progetto in regione EU, es. Frankfurt) ---
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave "service_role" (SEGRETA, solo lato server, mai nel browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Nome del bucket storage privato per i documenti
SUPABASE_BUCKET=documenti-corsi

# --- Brevo (invio email transazionali) ---
# Brevo > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-...
# Mittente verificato su Brevo (dominio/email autorizzati)
MITTENTE_EMAIL=noreply@autoscuolegasparellavicenza.it
MITTENTE_NOME=Autoscuole Gasparella
# Dove arrivano le notifiche di nuova prenotazione (casella segreteria)
SEGRETERIA_EMAIL=info@autoscuolegasparellavicenza.it

# --- Area segreteria protetta ---
# Password unica per accedere alla lista prenotazioni + download documenti
SEGRETERIA_PASSWORD=cambia-questa-password-lunga

# --- URL pubblico del sito (per i link nelle email) ---
SITE_URL=https://www.autoscuolegasparellavicenza.it
